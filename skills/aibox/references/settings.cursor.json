{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "python3 $HOME/.cursor/hooks/aibox_hooks.py beforeShellExecution"
      }
    ],
    "afterShellExecution": [
      {
        "command": "python3 $HOME/.cursor/hooks/aibox_hooks.py afterShellExecution"
      }
    ],
    "afterFileEdit": [
      {
        "command": "python3 $HOME/.cursor/hooks/aibox_hooks.py afterFileEdit"
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "python3 $HOME/.cursor/hooks/aibox_hooks.py beforeSubmitPrompt"
      }
    ]
  }
}

{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"%USERPROFILE%\\.workbuddy\\hooks\\aibox_hooks.py\" PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"%USERPROFILE%\\.workbuddy\\hooks\\aibox_hooks.py\" PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"%USERPROFILE%\\.workbuddy\\hooks\\aibox_hooks.py\" UserPromptSubmit",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
